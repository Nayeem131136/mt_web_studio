# Comma-separated list of emails allowed to log into /admin (email/password
# login via Supabase Auth). No spaces around commas. This MUST match the
# is_admin() function in supabase-schema.sql.
VITE_ADMIN_EMAILS="admin@mtwebstudio.com"

# From your Supabase project: Project Settings -> API
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: automatic client confirmation email via EmailJS (free tier: 200
# emails/month, no backend or billing card needed). Leave blank to skip —
# the app still works fine without these, it just won't send confirmation
# emails automatically.
#
# Get these from https://www.emailjs.com after creating a free account:
#   1. Email Services -> Add New Service (Gmail is easiest) -> copy the Service ID
#   2. Email Templates -> Create Template -> use {{to_name}}, {{business_name}},
#      {{reference_id}}, {{package_name}}, {{track_url}} as variables -> copy the Template ID
#   3. Account -> General -> copy your Public Key
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
